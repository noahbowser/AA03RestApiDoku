  "description": "Task-API mit Express, dokumentiert mit OpenAPI 3.1 und Swagger UI",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "verify": "node scripts/verify-docs.js",
    "export:openapi": "node -e \"require('fs').writeFileSync('openapi.json', JSON.stringify(require('./src/docs/swagger').openapiSpec, null, 2))\""
